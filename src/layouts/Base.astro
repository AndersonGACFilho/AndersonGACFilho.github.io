---
import '../styles/global.css';
import LangSwitch from '../components/LangSwitch.astro';
import ThemeSwitch from '../components/ThemeSwitch.astro';
import { useTranslations, localize, stripLocale, otherLang, type Lang } from '../i18n/ui';

interface Props {
  title: string;
  description?: string;
  lang: Lang;
  /** Path in the *other* language; defaults to the mirrored route. */
  altPath?: string;
  /**
   * Path of the real translation, for hreflang. Defaults to the mirrored
   * route, true of every page that has a twin. Pass `null` where none exists
   * (an untranslated publication, the 404): hreflang has to be reciprocal, so a
   * link to a fallback index would make Google discard the pair entirely.
   */
  translation?: string | null;
  /** Home only: the standing name is the page's h1 there, and a link elsewhere. */
  home?: boolean;
}

const { title, description, lang, altPath, translation, home = false } = Astro.props;
const t = useTranslations(lang);
// Link preview crawlers treat a short description as thin content;
// LinkedIn warns below 100 characters. The tagline is kept short for
// display, so the description is its own string.
const desc = description ?? t('site.description');
const here = Astro.url.pathname;

const nav = [
  { href: localize('/projects', lang), label: t('nav.projects') },
  { href: localize('/games', lang), label: t('nav.games') },
  { href: localize('/research', lang), label: t('nav.research') },
  { href: localize('/publications', lang), label: t('nav.publications') },
  { href: localize('/teaching', lang), label: t('nav.teaching') },
  { href: localize('/cv', lang), label: t('nav.cv') },
];

const isCurrent = (href: string) => here === href || here === `${href}/`;
const canonical = new URL(here, Astro.site).toString();

// Canonicals here are directory-style, and to Google `/pt` and `/pt/` are two
// URLs. hreflang that disagrees with the canonical by a slash is not
// reciprocal, which is the one thing that makes it be ignored outright.
const asDir = (path: string) => (path.endsWith('/') ? path : `${path}/`);
const twin = translation === undefined ? localize(stripLocale(here), otherLang(lang)) : translation;
const enHref = twin === null ? null : new URL(asDir(lang === 'en' ? here : twin), Astro.site).toString();
const ptHref = twin === null ? null : new URL(asDir(lang === 'pt' ? here : twin), Astro.site).toString();
---

<!doctype html>
<html lang={lang === 'pt' ? 'pt-BR' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    {/* Sem isto as rotas EN e PT concorrem entre si em vez de se declararem
        traduções. A auto-referência é exigida pelo Google, não é redundância. */}
    {
      enHref && ptHref && (
        <>
          <link rel="alternate" hreflang="en" href={enHref} />
          <link rel="alternate" hreflang="pt-BR" href={ptHref} />
          <link rel="alternate" hreflang="x-default" href={enHref} />
        </>
      )
    }
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Anderson Gonçalves" />
    <meta property="og:locale" content={lang === 'pt' ? 'pt_BR' : 'en_US'} />
    {/* Absolute URL: link preview crawlers do not resolve relative paths.
        Declaring summary_large_image without an image is what stopped
        LinkedIn from building a preview at all. */}
    <meta property="og:image" content={new URL('/og-cover.png', Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Anderson Gonçalves — gameplay programmer and full stack engineer, MSc researcher at UFRGS" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={new URL('/og-cover.png', Astro.site).href} />
    {/* Cooper Hewitt para tudo que se lê, Martian Mono Condensed só no nome em
        pé, IBM Plex Mono só para código. Os `@font-face` estão em
        `styles/fonts.css`, com o porquê de cada família.

        ENTRAM NO PRELOAD SÓ AS QUE TODA PÁGINA PINTA NA PRIMEIRA TELA: o corpo,
        o negrito dos títulos e a condensada do nome. Sem o preload o navegador
        só descobre que precisa delas depois de baixar e interpretar o CSS. O
        itálico, o peso 300 e a monoespaçada ficam de fora de propósito. */}
    <link rel="preload" as="font" type="font/woff2" href="/fonts/cooper-hewitt-latin-400-normal.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/cooper-hewitt-latin-700-normal.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/martian-mono-condensed-800.woff2" crossorigin />
    {/* Valor inicial só; o script do ThemeSwitch corrige para o --bg real. */}
    <meta name="theme-color" content="#0f1a13" />
    {/* SEM PISCADA. Roda antes da primeira pintura e é síncrono de propósito:
        o site é estático e recarrega a cada navegação, então sem isto a
        pessoa vê um lampejo do tema errado em toda página. */}
    <script is:inline>
      try {
        var m = localStorage.getItem('site:theme');
        if (m === 'light' || m === 'dark') document.documentElement.setAttribute('data-theme', m);
      } catch (e) {
        /* janela anônima: fica a preferência do sistema */
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    {/* O NOME EM PÉ. No desktop é a coluna da esquerda, da altura da tela, e
        fica parado enquanto a página rola; no celular deita e abre a página.
        Na home ele é o próprio h1, porque lá não existe outro título. */}
    {
      home ? (
        <h1 class="spine"><a href={localize('/', lang)} aria-current="page">Anderson Gonçalves</a></h1>
      ) : (
        <p class="spine"><a href={localize('/', lang)}>Anderson Gonçalves</a></p>
      )
    }
    <header class="site-header">
      <nav class="site-nav" aria-label="Main">
        {
          nav.map((item) => (
            <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          ))
        }
      </nav>
      <div class="bar-controls">
        <ThemeSwitch lang={lang} />
        <LangSwitch lang={lang} altPath={altPath} />
      </div>
      {/* NO CELULAR A NAVEGAÇÃO É UMA FAIXA QUE ROLA DE LADO, e ela nasce no
          começo. Em /cv/ e /teaching/, que são os dois últimos rótulos, o
          traço que diz "você está aqui" ficava fora da vista — a única pista
          de localização da página sumia justo onde ela é mais necessária.

          Só isto não dá para fazer em CSS: o navegador traz para a vista o
          que recebe foco, não o que tem `aria-current`. O guarda de rolagem
          mantém a linha inerte no desktop, onde os seis rótulos cabem. */}
      <script is:inline>
        (function () {
          var faixa = document.querySelector('.site-nav');
          var atual = faixa && faixa.querySelector('[aria-current="page"]');
          if (atual && faixa.scrollWidth > faixa.clientWidth) {
            atual.scrollIntoView({ inline: 'center', block: 'nearest' });
          }
        })();
      </script>
    </header>

    <main id="main">
      <div class="wrap">
        <slot />
      </div>
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <span>© {new Date().getFullYear()} Anderson Gonçalves · {t('footer.built')}</span>
        <span class="site-footer-links">
          <a href="https://github.com/AndersonGACFilho">GitHub</a>
          <a href="https://www.linkedin.com/in/agacf/">LinkedIn</a>
          <a href="https://vertex-shift.itch.io">itch.io</a>
          <a href="mailto:andersonfilho09@gmail.com">E-mail</a>
        </span>
      </div>
    </footer>
  </body>
</html>
