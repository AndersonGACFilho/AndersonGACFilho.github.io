---
import '../styles/global.css';
import LangSwitch from '../components/LangSwitch.astro';
import ThemeSwitch from '../components/ThemeSwitch.astro';
import { useTranslations, localize, stripLocale, otherLang, type Lang } from '../i18n/ui';

interface Props {
  title: string;
  description?: string;
  lang: Lang;
  /** Path in the *other* language; defaults to the mirrored route. */
  altPath?: string;
  /**
   * Path of the real translation, for hreflang. Defaults to the mirrored
   * route, true of every page that has a twin. Pass `null` where none exists
   * (an untranslated article, the 404): hreflang has to be reciprocal, so a
   * link to a fallback index would make Google discard the pair entirely.
   */
  translation?: string | null;
}

const { title, description, lang, altPath, translation } = Astro.props;
const t = useTranslations(lang);
// Link preview crawlers treat a short description as thin content;
// LinkedIn warns below 100 characters. The tagline is kept short for
// display, so the description is its own string.
const desc = description ?? t('site.description');
const here = Astro.url.pathname;

const nav = [
  { href: localize('/projects', lang), label: t('nav.projects') },
  { href: localize('/games', lang), label: t('nav.games') },
  { href: localize('/research', lang), label: t('nav.research') },
  { href: localize('/articles', lang), label: t('nav.articles') },
  { href: localize('/teaching', lang), label: t('nav.teaching') },
  { href: localize('/cv', lang), label: t('nav.cv') },
];

const isCurrent = (href: string) => here === href || here === `${href}/`;
const canonical = new URL(here, Astro.site).toString();

// Canonicals here are directory-style, and to Google `/pt` and `/pt/` are two
// URLs. hreflang that disagrees with the canonical by a slash is not
// reciprocal, which is the one thing that makes it be ignored outright.
const asDir = (path: string) => (path.endsWith('/') ? path : `${path}/`);
const twin = translation === undefined ? localize(stripLocale(here), otherLang(lang)) : translation;
const enHref = twin === null ? null : new URL(asDir(lang === 'en' ? here : twin), Astro.site).toString();
const ptHref = twin === null ? null : new URL(asDir(lang === 'pt' ? here : twin), Astro.site).toString();
---

<!doctype html>
<html lang={lang === 'pt' ? 'pt-BR' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    {/* Sem isto as rotas EN e PT concorrem entre si em vez de se declararem
        traduções. A auto-referência é exigida pelo Google, não é redundância. */}
    {
      enHref && ptHref && (
        <>
          <link rel="alternate" hreflang="en" href={enHref} />
          <link rel="alternate" hreflang="pt-BR" href={ptHref} />
          <link rel="alternate" hreflang="x-default" href={enHref} />
        </>
      )
    }
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Anderson Gonçalves" />
    <meta property="og:locale" content={lang === 'pt' ? 'pt_BR' : 'en_US'} />
    {/* Absolute URL: link preview crawlers do not resolve relative paths.
        Declaring summary_large_image without an image is what stopped
        LinkedIn from building a preview at all. */}
    <meta property="og:image" content={new URL('/og-cover.png', Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Anderson Gonçalves — gameplay programmer, backend engineer and Game AI researcher" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={new URL('/og-cover.png', Astro.site).href} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {/* Bricolage Grotesque para títulos e interface, Source Serif 4 para o
        corpo, IBM Plex Mono só para código. A monoespaçada não rotula mais
        metadado. */}
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,600;12..96,700&family=IBM+Plex+Mono:wght@400&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&display=swap"
    />
    {/* Valor inicial só; o script do ThemeSwitch corrige para o --bg real. */}
    <meta name="theme-color" content="#13110e" />
    {/* SEM PISCADA. Roda antes da primeira pintura e é síncrono de propósito:
        o site é estático e recarrega a cada navegação, então sem isto a
        pessoa vê um lampejo do tema errado em toda página. */}
    <script is:inline>
      try {
        var m = localStorage.getItem('site:theme');
        if (m === 'light' || m === 'dark') document.documentElement.setAttribute('data-theme', m);
      } catch (e) {
        /* janela anônima: fica a preferência do sistema */
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={localize('/', lang)}>Anderson Filho <span>/ dev, games, AI</span></a>
        <nav class="site-nav" aria-label="Main">
          {
            nav.map((item) => (
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            ))
          }
        </nav>
        <ThemeSwitch lang={lang} />
        <LangSwitch lang={lang} altPath={altPath} />
      </div>
    </header>

    <main id="main">
      <div class="wrap">
        <slot />
      </div>
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <span>© {new Date().getFullYear()} Anderson Gonçalves · {t('footer.built')}</span>
        <span class="card-links">
          <a href="https://github.com/AndersonGACFilho">GitHub</a>
          <a href="https://www.linkedin.com/in/agacf/">LinkedIn</a>
          <a href="https://vertex-shift.itch.io">itch.io</a>
          <a href="mailto:andersonfilho09@gmail.com">E-mail</a>
        </span>
      </div>
    </footer>
  </body>
</html>
