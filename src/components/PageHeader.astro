---
/** The header every section page shares: kicker, title, intro, optional extras. */
interface Props {
  kicker?: string;
  title: string;
  intro?: string;
  /** CSS colour for the kicker — usually a track colour. */
  accent?: string;
}
const { kicker, title, intro, accent = 'var(--text-faint)' } = Astro.props;
---

<header class="page-head">
  {kicker && <p class="kicker" style={`--kicker: ${accent}`}>{kicker}</p>}
  <h1>{title}</h1>
  {intro && <p class="intro">{intro}</p>}
  <slot />
</header>

<style>
  .page-head { margin-block: 28px 40px; max-width: 46rem; }
  /* Era caixa-alta espaçada em monoespaçada — a moldura de template mais
     reconhecível que existe, e que aparecia acima de todo título do site.
     Agora é uma frase legível, na grotesca, com a cor da trilha. */
  .kicker {
    font-family: var(--display);
    color: var(--kicker);
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin: 0 0 8px;
  }
  .page-head h1 { margin-bottom: 12px; text-wrap: balance; }
  .intro { color: var(--text-dim); font-size: 1.05rem; margin: 0; }
</style>
