---
/** The header every section page shares: title, kicker, intro, optional extras. */
interface Props {
  kicker?: string;
  title: string;
  intro?: string;
  /** CSS colour for the kicker. Defaults to the reading ink. */
  accent?: string;
}
const { kicker, title, intro, accent = 'var(--text)' } = Astro.props;
---

<header class="page-head">
  <h1>{title}</h1>
  {kicker && <p class="kicker" style={`--kicker: ${accent}`}>{kicker}</p>}
  {intro && <p class="intro">{intro}</p>}
  <slot />
</header>

<style>
  .page-head { margin-block: clamp(32px, 6svh, 72px) 48px; max-width: 46rem; }
  .page-head h1 { margin-bottom: 14px; text-wrap: balance; }
  /* O KICKER VEIO PARA BAIXO DO TÍTULO. Em cima de todo título ele era a
     moldura de template mais reconhecível do site. Embaixo, em caixa alta
     pequena e espaçada, ele faz o papel da linha que diz o que eu faço, logo
     depois do nome: é o único texto do site em caixa alta. */
  .kicker {
    font-family: var(--display);
    color: var(--kicker);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    line-height: 1.6;
    margin: 0 0 20px;
  }
  .intro { color: var(--text-dim); font-size: 1.06rem; margin: 0; }
</style>
