---
import type { CollectionEntry } from 'astro:content';
import TrackBadge from './TrackBadge.astro';
import { useTranslations, localize, formatDate, type Lang, type UIKey } from '../i18n/ui';
import { trackColor } from '../lib/tracks';

interface Props { publication: CollectionEntry<'publications'>; lang: Lang; }
const { publication, lang } = Astro.props;
const d = publication.data;
const t = useTranslations(lang);
// Collection ids carry the language folder: "en/my-post" -> "my-post".
const slug = publication.id.replace(/^(en|pt)\//, '');
const venue = d.venue;
---

<article class="card" style={`--track: ${trackColor[d.tracks[0]]}`}>
  <div class="badge-row">
    {d.tracks.map((track) => <TrackBadge track={track} lang={lang} />)}
  </div>
  <h3><a href={localize(`/publications/${slug}`, lang)}>{d.title}</a></h3>

  {
    venue && (
      <p class="venue">
        <span class="venue-status">{t(`venue.${venue.status}` as UIKey)}</span>{' '}
        <strong>{venue.name}</strong>
        {venue.full && <span class="venue-full">{venue.full}</span>}
      </p>
    )
  }

  <p>{d.summary}</p>

  <div class="card-meta">
    <span>{formatDate(d.date, lang)}</span>
    {d.tags.map((tag) => <span>#{tag}</span>)}
  </div>
  {/* Rótulos repetidos cartão a cartão; o `aria-label` diz de qual publicação
      é cada link. Mesma razão do `ProjectCard`. */}
  <div class="card-links">
    <a href={localize(`/publications/${slug}`, lang)} aria-label={`${t('cta.read')}: ${d.title}`}>
      {t('cta.read')}
    </a>
    {d.pdf && <a href={d.pdf} aria-label={`PDF: ${d.title}`}>PDF</a>}
    {venue?.url && (
      <a href={venue.url} aria-label={`${t('cta.proceedings')}: ${d.title}`}>
        {t('cta.proceedings')}
      </a>
    )}
  </div>
</article>

<style>
  .venue { margin: 0; font-size: 0.88rem; }
  .venue-status { color: var(--text-faint); }
  .venue-full { display: block; color: var(--text-faint); font-size: 0.82rem; }
</style>
