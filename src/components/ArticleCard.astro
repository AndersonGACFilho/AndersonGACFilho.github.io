---
import type { CollectionEntry } from 'astro:content';
import TrackBadge from './TrackBadge.astro';
import { useTranslations, localize, formatDate, type Lang } from '../i18n/ui';
import { trackColor } from '../lib/tracks';

interface Props { article: CollectionEntry<'articles'>; lang: Lang; }
const { article, lang } = Astro.props;
const d = article.data;
const t = useTranslations(lang);
// Collection ids carry the language folder: "en/my-post" -> "my-post".
const slug = article.id.replace(/^(en|pt)\//, '');
---

<article class="card" style={`--track: ${trackColor[d.tracks[0]]}`}>
  <div class="badge-row">
    {d.tracks.map((track) => <TrackBadge track={track} lang={lang} />)}
  </div>
  <h3><a href={localize(`/articles/${slug}`, lang)}>{d.title}</a></h3>
  <p>{d.summary}</p>
  <div class="card-meta">
    <span>{formatDate(d.date, lang)}</span>
    {d.tags.map((tag) => <span>#{tag}</span>)}
  </div>
  <div class="card-links">
    <a href={localize(`/articles/${slug}`, lang)}>{t('cta.read')} →</a>
    {d.pdf && <a href={d.pdf}>PDF</a>}
  </div>
</article>
