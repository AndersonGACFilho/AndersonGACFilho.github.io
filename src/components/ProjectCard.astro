---
import type { CollectionEntry } from 'astro:content';
import TrackBadge from './TrackBadge.astro';
import { useTranslations, localize, formatDate, type Lang, type UIKey } from '../i18n/ui';
import { trackColor, pick } from '../lib/tracks';
import { repoInfo, repoUrl } from '../lib/github';

interface Props { project: CollectionEntry<'projects'>; lang: Lang; }
const { project, lang } = Astro.props;
const d = project.data;
const t = useTranslations(lang);

// Live numbers come from GitHub; the description in the .md stays the human pitch.
const meta = await repoInfo(d.repo);
---

{/* DUAS COLUNAS, DOIS PAPÉIS. À esquerda o que se lê de ponta a ponta — o
    título, o resumo, a tecnologia. À direita o que se consulta de relance:
    trilha, números, links. Acima de 760px a direita alinha pela margem, que é
    o que faz a linha ler como índice e não como segunda coluna de texto;
    abaixo disso as duas viram uma pilha só.

    O TÍTULO VEM ANTES DA TRILHA no HTML, ao contrário de antes. Quem lê por
    leitor de tela ouvia "Game Dev, Game AI Research" antes de saber de qual
    projeto se falava. */}
<article class="card" style={`--track: ${trackColor[d.tracks[0]]}`} data-tracks={d.tracks.join(' ')}>
  <div class="card-main">
    <h3>{d.title}{d.status && <span class="status">{t(`status.${d.status}` as UIKey)}</span>}</h3>
    <p>{pick(d.summary, lang)}</p>

    {
      d.tech.length > 0 && (
        <div class="tag-row">
          {d.tech.map((item) => (
            <span class="tag">{item}</span>
          ))}
        </div>
      )
    }
  </div>

  <div class="card-side">
    <div class="badge-row">
      {d.tracks.map((track) => <TrackBadge track={track} lang={lang} />)}
    </div>

    <div class="card-meta">
      {meta?.language && <span>{meta.language}</span>}
      {meta && meta.stars > 0 && <span>★ {meta.stars}</span>}
      {meta && <span>{t('label.updated')} {formatDate(new Date(meta.pushedAt), lang)}</span>}
      {d.private && <span>{t('label.private')}</span>}
      {!meta && d.year && <span>{d.year}</span>}
    </div>

    {/* O RÓTULO VISÍVEL SOZINHO NÃO BASTA AQUI. Cada linha repete os mesmos
        quatro rótulos, então quem navega por leitor de tela — que costuma pedir
        a lista de links da página em vez de ler tudo em ordem — ouvia "Código,
        Código, Código, Código" sem nada que dissesse de qual projeto era cada
        um. O `aria-label` começa pelo mesmo texto que está na tela porque quem
        navega por voz fala o que enxerga: trocar a ordem quebraria o comando. */}
    <div class="link-row">
      {d.play && (
        <a href={localize(`/play/${d.play}`, lang)} aria-label={`${t('cta.play')}: ${d.title}`}>
          ▶ {t('cta.play')}
        </a>
      )}
      {d.detail && (
        <a href={localize(d.detail, lang)} aria-label={`${t('cta.read')}: ${d.title}`}>
          {t('cta.read')}
        </a>
      )}
      {d.repo && (
        <a href={repoUrl(d.repo)} aria-label={`${t('cta.source')}: ${d.title}`}>
          {t('cta.source')}
        </a>
      )}
      {d.itch && (
        <a href={d.itch} aria-label={`${t('cta.itch')}: ${d.title}`}>
          {t('cta.itch')}
        </a>
      )}
    </div>
  </div>
</article>

<style>
  /* Era caixa-alta com tracking dentro de uma pílula tracejada. Caixa-alta em
     rótulo pequeno é moldura de template, e o tracejado prometia um estado
     provisório que a palavra já diz sozinha. */
  .status {
    margin-left: 10px;
    font-family: var(--display);
    font-size: 0.72rem;
    font-weight: 500;
    color: var(--text-faint);
    vertical-align: middle;
    white-space: nowrap;
  }
</style>
