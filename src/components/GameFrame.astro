---
import type { CollectionEntry } from 'astro:content';
import { useTranslations, type Lang } from '../i18n/ui';
import { pick } from '../lib/tracks';

interface Props { game: CollectionEntry<'games'>; lang: Lang; }
const { game, lang } = Astro.props;
const d = game.data;
const t = useTranslations(lang);

// Builds live in the sibling `webgl-builds` repo, served from the same origin.
// The language rides along so a build with its own strings can match the
// page it is embedded in. Builds that ignore it are unaffected.
const base = import.meta.env.PUBLIC_GAMES_BASE ?? '/webgl-builds';
const src = `${base}/${d.buildPath}/?lang=${lang}`;
const id = `game-${game.id}`;

// Cinema mode has to fit the frame inside the viewport on both axes.
// `aspect-ratio` alone only ever constrains one of them, so the ratio is
// also exposed as a plain number the width calculation can use.
const [ratioW, ratioH] = d.ratio.split('/').map((part) => Number(part.trim()));
const ratioNum = Number.isFinite(ratioW / ratioH) ? ratioW / ratioH : 16 / 9;
---

<figure class="game" id={id} style={`--ratio: ${d.ratio}; --ratio-num: ${ratioNum}`}>
  {
    d.live ? (
      <div class="game-stage" data-src={src}>
        {/* The build is only fetched on click: a Unity bundle is tens of MB. */}
        <button class="game-poster" type="button" data-play>
          {d.cover && <img src={d.cover} alt="" loading="lazy" />}
          <span class="game-poster-inner">
            <span class="play-icon" aria-hidden="true">▶</span>
            <strong>{d.title}</strong>
            <small>{pick(d.tagline, lang)}</small>
          </span>
        </button>
      </div>
    ) : (
      <div class="game-stage game-stage-empty">
        <p>{t('label.soon')}</p>
        {d.itch && (
          <p class="muted">
            {t('play.fallback')} <a href={d.itch}>itch.io →</a>
          </p>
        )}
      </div>
    )
  }

  {d.live && (
    <button class="cinema-close" type="button" data-cinema-close aria-label={t('label.close')}>
      ✕ <span>{t('label.close')}</span>
    </button>
  )}

  <figcaption>
    <span>
      {d.controls && <><strong>{t('label.controls')}:</strong> {pick(d.controls, lang)}</>}
    </span>
    {d.live && (
      <span class="game-actions">
        <button class="btn" type="button" data-cinema>▭ {t('label.cinema')}</button>
        <button class="btn" type="button" data-fullscreen>⛶ {t('label.fullscreen')}</button>
      </span>
    )}
  </figcaption>
</figure>

<style>
  .game { margin: 0; }
  .game-stage {
    position: relative;
    aspect-ratio: var(--ratio);
    width: 100%;
    background: radial-gradient(circle at 50% 30%, var(--bg-hover), var(--bg-elev));
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .game-stage :global(iframe) { width: 100%; height: 100%; border: 0; display: block; }
  .game-stage-empty {
    aspect-ratio: auto;
    min-height: 220px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 24px;
    gap: 4px;
  }
  .game-stage-empty p { margin: 0; }
  .game-poster {
    position: absolute;
    inset: 0;
    width: 100%;
    display: grid;
    place-items: center;
    background: none;
    border: 0;
    color: var(--text);
    cursor: pointer;
    padding: 0;
  }
  .game-poster img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0.55; }
  .game-poster-inner {
    position: relative;
    display: grid;
    gap: 4px;
    justify-items: center;
    padding: 20px;
  }
  .game-poster strong { font-size: 1.15rem; }
  .game-poster small { color: var(--text-dim); }
  .play-icon {
    display: grid;
    place-items: center;
    width: 62px;
    height: 62px;
    margin-bottom: 8px;
    border-radius: 50%;
    background: var(--gamedev);
    color: #14161c;
    font-size: 1.4rem;
    padding-left: 4px;
    transition: transform 0.18s ease;
  }
  .game-poster:hover .play-icon { transform: scale(1.08); }
  figcaption {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    margin-top: 12px;
    font-size: 0.88rem;
    color: var(--text-dim);
  }
  .game-actions { display: flex; gap: 8px; flex-wrap: wrap; }

  /* Cinema mode is pure CSS on purpose: moving the iframe in the DOM
     reloads it, and a running game would restart. */
  .cinema-close { display: none; }
  .game.cinema {
    --cinema-chrome: 150px;   /* top bar, caption and padding */
    position: fixed;
    inset: 0;
    z-index: 200;
    margin: 0;
    padding: 56px 24px 24px;
    background: rgba(2, 3, 8, 0.96);
    backdrop-filter: blur(3px);
    display: grid;
    grid-template-rows: 1fr auto;
    gap: 14px;
    place-items: center;
  }
  .game.cinema .game-stage {
    /* Whichever axis runs out first wins. */
    width: min(100%, calc((100vh - var(--cinema-chrome)) * var(--ratio-num)));
    height: auto;
    aspect-ratio: var(--ratio);
  }
  .game.cinema figcaption { margin: 0; max-width: 1100px; }
  .game.cinema .cinema-close {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    position: absolute;
    top: 14px;
    right: 18px;
    background: var(--bg-elev);
    color: var(--text);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 6px 12px;
    font: inherit;
    font-size: 0.85rem;
    cursor: pointer;
  }
  .game.cinema .cinema-close:hover { background: var(--bg-hover); }
  :global(body.cinema-open) { overflow: hidden; }

  .game:fullscreen { background: #000; display: grid; place-items: center; }
  .game:fullscreen .game-stage { height: 100%; width: auto; aspect-ratio: var(--ratio); }
  .game:fullscreen figcaption { display: none; }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.game').forEach((root) => {
    const stage = root.querySelector<HTMLElement>('.game-stage');
    const poster = root.querySelector<HTMLButtonElement>('[data-play]');

    poster?.addEventListener('click', () => {
      const src = stage?.dataset.src;
      if (!stage || !src) return;
      const frame = document.createElement('iframe');
      frame.src = src;
      frame.title = root.querySelector('strong')?.textContent ?? 'game';
      frame.allow = 'autoplay; fullscreen; gamepad; cross-origin-isolated';
      frame.setAttribute('allowfullscreen', '');
      stage.replaceChildren(frame);
    });

    const exitCinema = () => {
      root.classList.remove('cinema');
      document.body.classList.remove('cinema-open');
    };

    root.querySelector<HTMLButtonElement>('[data-cinema]')?.addEventListener('click', () => {
      root.classList.add('cinema');
      document.body.classList.add('cinema-open');
      root.querySelector<HTMLIFrameElement>('iframe')?.focus();
    });

    root.querySelector<HTMLButtonElement>('[data-cinema-close]')?.addEventListener('click', exitCinema);

    // Esc reaches us only when focus is outside the iframe; the close
    // button is the reliable way out while the game holds the keyboard.
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && root.classList.contains('cinema')) exitCinema();
    });

    root.querySelector<HTMLButtonElement>('[data-fullscreen]')?.addEventListener('click', () => {
      if (document.fullscreenElement) document.exitFullscreen();
      else root.requestFullscreen?.();
    });
  });
</script>
