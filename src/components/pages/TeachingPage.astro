---
import PageHeader from '../PageHeader.astro';
import { useTranslations, type Lang } from '../../i18n/ui';
import { ensino } from '../../data/teaching';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);
const pick = (b: { en: string; pt: string }) => (lang === 'pt' ? b.pt : b.en);

const rotuloSituacao = {
  'no-ar': t('teaching.status.live'),
  preparando: t('teaching.status.wip'),
  'outro-docente': t('teaching.status.other'),
} as const;
---

<PageHeader
  kicker={t('kicker.teaching')}
  title={t('nav.teaching')}
  intro={t('teaching.intro')}
  accent="var(--fullstack)"
/>

{
  ensino.map((inst) => (
    <section>
      <div class="section-head">
        <h2>{inst.nome}</h2>
        <span class="more">{inst.local}</span>
      </div>

      {inst.cursos.map((curso) => (
        <article class="curso">
          <header class="curso-topo">
            <h3>{pick(curso.nome)}</h3>
            <p class="nivel">{pick(curso.nivel)}</p>
          </header>

          {curso.edicoes.map((ed) => (
            <div class="edicao">
              <div class="edicao-topo">
                <p class="quando">
                  <strong>{ed.ano}</strong>
                  <span>{ed.periodo}</span>
                  <span>{pick(ed.turno)}</span>
                </p>
                {ed.href && (
                  <a class="btn btn-primary" href={ed.href}>
                    {t('teaching.cta')}
                  </a>
                )}
              </div>

              <ul class="ucs">
                {ed.ucs.map((uc) => (
                  <li class={uc.situacao === 'no-ar' ? 'ativa' : undefined}>
                    <span class="codigo">{uc.codigo}</span>
                    <span class="nome">{pick(uc.nome)}</span>
                    <span class="ch">{uc.ch}</span>
                    <span class={`situacao ${uc.situacao}`}>{rotuloSituacao[uc.situacao]}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </article>
      ))}
    </section>
  ))
}

<style>
  .curso {
    border: 1px solid var(--border);
    border-left: 3px solid var(--fullstack);
    border-radius: var(--radius);
    background: var(--bg-elev);
    padding: 20px 22px;
  }
  .curso-topo h3 { margin: 0; font-size: 1.3rem; }
  .nivel { margin: 2px 0 0; color: var(--text-dim); font-size: 0.92rem; }

  .edicao { margin-top: 20px; padding-top: 18px; border-top: 1px solid var(--border); }
  .edicao-topo {
    display: flex;
    gap: 16px;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    margin-bottom: 14px;
  }
  .quando {
    display: flex;
    gap: 14px;
    align-items: baseline;
    flex-wrap: wrap;
    margin: 0;
    color: var(--text-dim);
    font-size: 0.92rem;
    font-variant-numeric: tabular-nums;
  }
  .quando strong {
    font-family: var(--display);
    font-size: 1.15rem;
    color: var(--text);
    letter-spacing: -0.02em;
  }

  /* Uma linha por UC, com a situação escrita. Quem chega vê o curso inteiro e
     sabe o que ainda vem, em vez de achar que só existe o que está no ar. */
  .ucs { list-style: none; margin: 0; padding: 0; display: grid; gap: 0; }
  .ucs li {
    display: grid;
    grid-template-columns: 3.2em 1fr auto auto;
    gap: 14px;
    align-items: baseline;
    padding: 11px 0;
    border-top: 1px solid var(--border);
    color: var(--text-dim);
  }
  .ucs li:first-child { border-top: none; }
  .ucs .codigo { font-family: var(--display); font-weight: 700; color: var(--text-faint); }
  .ucs li.ativa .codigo { color: var(--fullstack); }
  .ucs li.ativa .nome { color: var(--text); font-weight: 600; }
  .ucs .ch { font-size: 0.86rem; font-variant-numeric: tabular-nums; }
  .situacao { font-family: var(--display); font-size: 0.8rem; white-space: nowrap; }
  .situacao.no-ar { color: var(--feito); font-weight: 600; }

  @media (max-width: 560px) {
    .ucs li { grid-template-columns: 3.2em 1fr; }
    .ucs .ch, .situacao { grid-column: 2; }
  }
</style>
