---
import ArticleCard from '../ArticleCard.astro';
import PageHeader from '../PageHeader.astro';
import { useTranslations, type Lang } from '../../i18n/ui';
import { getArticles } from '../../lib/content';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);

const all = await getArticles(lang);
// Anything with a `venue` is a paper; the rest are notes and posts.
const publications = all.filter((article) => article.data.venue);
const notes = all.filter((article) => !article.data.venue);
---

<PageHeader kicker={t('kicker.articles')} title={t('nav.articles')} intro={t('articles.intro')} accent="var(--research)" />

<section>
  <div class="section-head"><h2>{t('section.publications')}</h2></div>
  {
    publications.length > 0 ? (
      <div class="grid">
        {publications.map((article) => <ArticleCard article={article} lang={lang} />)}
      </div>
    ) : (
      <p class="empty">{t('publications.empty')}</p>
    )
  }
</section>

<section>
  <div class="section-head"><h2>{t('section.notes')}</h2></div>
  {
    notes.length > 0 ? (
      <div class="grid">
        {notes.map((article) => <ArticleCard article={article} lang={lang} />)}
      </div>
    ) : (
      <p class="empty">{t('articles.empty')}</p>
    )
  }
</section>

<style>
  section:first-of-type { margin-top: 0; }
</style>
