---
import GameFrame from '../GameFrame.astro';
import ProjectCard from '../ProjectCard.astro';
import PublicationCard from '../PublicationCard.astro';
import { useTranslations, localize, type Lang } from '../../i18n/ui';
import { TRACKS, trackColor, trackLabelKey, trackDescKey } from '../../lib/tracks';
import { getPublications, getProjects, getFeaturedGame, SLIDES_URL } from '../../lib/content';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);

const projects = (await getProjects()).filter((p) => p.data.featured);
const publications = (await getPublications(lang)).slice(0, 3);
const game = await getFeaturedGame();
const trackCount = (track: string) =>
  projects.filter((p) => (p.data.tracks as string[]).includes(track)).length;
---

{/* O JOGO DESCEU DO TOPO. Ele era a primeira coisa da página, logo abaixo
    do nome, e com ele ali a home se lia como portfólio só de jogos. O site
    também serve candidatura de backend e full stack (o /cv tem uma chave de
    foco para isso), então a primeira tela é quem eu sou e as três frentes.

    O nome em pé, que aqui é o h1 (ver `Base.astro`), ocupa a coluna da
    esquerda; papel, texto e frentes começam logo abaixo da navegação. Eles já
    desceram até o pé da tela, e em monitor alto isso deixava um buraco em
    cima. */}
<section class="hero">
  <p class="hero-role">{t('hero.role')}</p>
  <p class="hero-blurb">{t('hero.blurb')}</p>
  <div class="btn-row">
    <a class="btn" href={localize('/projects', lang)}>{t('hero.cta.projects')}</a>
    <a class="btn" href={localize('/cv', lang)}>{t('hero.cta.cv')}</a>
  </div>

  <h2 class="so-leitor">{t('section.tracks')}</h2>
  <ul class="trilhas">
    {
      TRACKS.map((track) => (
        <li style={`--track: ${trackColor[track]}`}>
          <a href={`${localize('/projects', lang)}#${track}`}>
            <span class="trilha-nome">{t(trackLabelKey(track))}</span>
            <span class="trilha-desc">{t(trackDescKey(track))}</span>
            <span class="trilha-conta">
              {trackCount(track)} {t('nav.projects').toLowerCase()}
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</section>

{
  game && (
    <section>
      <div class="section-head">
        <h2>{t('section.game')}</h2>
        <a class="more" href={localize('/games', lang)}>{t('cta.all.games')}</a>
      </div>
      <GameFrame game={game} lang={lang} />
    </section>
  )
}

<section>
  <div class="section-head">
    <h2>{t('section.projects')}</h2>
    <a class="more" href={localize('/projects', lang)}>{t('cta.all.projects')}</a>
  </div>
  <div class="index">
    {projects.map((project) => <ProjectCard project={project} lang={lang} />)}
  </div>
</section>

<section>
  <div class="section-head">
    <h2>{t('section.publications')}</h2>
    <a class="more" href={localize('/publications', lang)}>{t('cta.all.publications')}</a>
  </div>
  {
    publications.length > 0 ? (
      <div class="index">
        {publications.map((entry) => <PublicationCard publication={entry} lang={lang} />)}
      </div>
    ) : (
      <p class="empty">{t('publications.empty')}</p>
    )
  }
</section>

<section>
  <div class="section-head"><h2>{t('section.teaching')}</h2></div>
  <p class="muted">{t('teaching.intro')}</p>
  <a class="btn" href={SLIDES_URL}>{t('teaching.cta')}</a>
</section>

<style>
  .hero { max-width: 33rem; margin-block: clamp(32px, 6svh, 72px) 96px; }

  /* Em tela larga as frentes sobem para o lado do texto, as duas colunas
     começando na mesma altura. */
  @media (min-width: 1200px) {
    .hero {
      display: grid;
      grid-template-columns: minmax(0, 33rem) minmax(0, 30rem);
      column-gap: clamp(3rem, 5vw, 6rem);
      align-items: start;
      max-width: none;
    }
    .hero > .trilhas { grid-column: 2; grid-row: 1 / span 3; margin: 0; }
  }

  .hero-role {
    font-family: var(--display);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    line-height: 1.6;
    margin: 0 0 20px;
    max-width: 26rem;
  }
  .hero-blurb { font-size: 1.06rem; margin: 0 0 28px; }

  .trilhas { list-style: none; margin: 56px 0 0; padding: 0; display: grid; gap: 26px; }
  .trilhas a { display: grid; gap: 4px; }
  .trilhas a:hover .trilha-nome { color: var(--text); }
  .trilha-nome { font-weight: 700; font-size: 1.45rem; line-height: 1.1; color: var(--track); }
  .trilha-desc { font-size: 0.96rem; line-height: 1.45; }
  .trilha-conta { font-size: 0.88rem; font-weight: 300; letter-spacing: 0.04em; }
</style>
