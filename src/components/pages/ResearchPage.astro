---
import { getCollection } from 'astro:content';
import { useTranslations, localize, type Lang, type UIKey } from '../../i18n/ui';
import { research, experiments, paperTitle, authors, affiliation } from '../../i18n/research';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);
const copy = research[lang];
const evaluation = experiments[lang];

// Link the ERAMIA entry only while it is not a draft, and always say where
// the paper stands: accepted and published read differently on a CV.
const eramia = (await getCollection('publications')).find((entry) => entry.id === `${lang}/eramia-rs`);
const eramiaLive = eramia && !eramia.data.draft;
const eramiaStatus = eramia?.data.venue?.status ?? 'in-preparation';
const eramiaVenue = eramia?.data.venue?.name ?? 'ERAMIA-RS';
---

<header class="head">
  <h1>{paperTitle}</h1>
  <p class="kicker">{copy.kicker}</p>
  <ul class="authors">
    {
      authors.map((author) => (
        <li>
          {author.url ? (
            <a href={author.url}>{author.name}</a>
          ) : (
            <span class={author.self ? 'self' : ''}>{author.name}</span>
          )}
        </li>
      ))
    }
  </ul>
  <p class="affiliation">{affiliation}</p>
</header>

<blockquote class="thesis">
  {copy.thesis.map((line) => <p>{line}</p>)}
</blockquote>

<p class="intro">{copy.intro}</p>

<section class="blocks">
  {
    copy.blocks.map((block) => (
      <article>
        <h2>{block.heading}</h2>
        {block.body.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </article>
    ))
  }
</section>

<section>
  <div class="section-head"><h2>{evaluation.heading}</h2></div>
  <div class="grid grid-3">
    {
      evaluation.columns.map((column) => (
        <div class="card" style="--track: var(--research)">
          <h3>{column.title}</h3>
          <ul>
            {column.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>

<section>
  <div class="section-head"><h2>{copy.materials}</h2></div>
  <p class="muted">{copy.materialsIntro}</p>

  <figure class="poster">
    <a href="/research/poster-htn-morl.pdf">
      <img src="/research/poster-htn-morl.jpg" alt={paperTitle} loading="lazy" width="1490" height="2107" />
    </a>
    <figcaption>{copy.posterCaption}</figcaption>
  </figure>

  <ul class="materials">
    <li>
      <a href="/research/poster-htn-morl.pdf">{copy.posterLabel}</a>
      <span class="muted">{copy.posterMeta}</span>
    </li>
    <li>
      {
        eramiaLive ? (
          <a href={localize('/publications/eramia-rs', lang)}>{copy.paperLabel}</a>
        ) : (
          <span>{copy.paperLabel}</span>
        )
      }
      <span class="muted">{t(`venue.${eramiaStatus}` as UIKey)} {eramiaVenue}</span>
      {eramiaLive && eramia.data.pdf && <a href={eramia.data.pdf}>PDF</a>}
    </li>
    <li>
      <span>{copy.codeLabel}</span>
      <span class="muted">{copy.codeNote}</span>
    </li>
  </ul>
</section>

<style>
  /* One measure for the whole header block, so title, authors and affiliation
     line up instead of each wrapping at its own width. */
  .head { margin-block: clamp(40px, 12svh, 140px) 40px; max-width: 46rem; }
  .head h1 { font-size: clamp(1.7rem, 3.6vw, 2.4rem); text-wrap: balance; margin-bottom: 14px; }
  /* Segue o `.kicker` do PageHeader: embaixo do título, em caixa alta
     pequena, na tinta de leitura. */
  .kicker {
    font-family: var(--display);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    line-height: 1.6;
    margin-bottom: 10px;
  }
  .authors {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 0;
    margin: 14px 0 6px;
    padding: 0;
    color: var(--text-dim);
  }
  .authors li { white-space: nowrap; }
  .authors li + li::before { content: '·'; color: var(--text-faint); margin-inline: 10px; }
  .authors .self { color: var(--accent); font-weight: 700; }
  .authors a { text-decoration: underline; text-decoration-color: var(--border-strong); text-underline-offset: 0.2em; }
  .affiliation { color: var(--text-faint); font-size: 0.9rem; margin: 0; }

  /* A tese são três frases curtas, e elas não precisam de caixa para serem o
     centro da página: corpo maior, negrito e vazio em volta. A caixa com
     filete roxo que estava aqui era o mesmo tique do índice. */
  .thesis {
    max-width: 46rem;
    margin: 0 0 40px;
  }
  .thesis p { margin: 0; font-size: 1.3rem; font-weight: 700; line-height: 1.35; }

  .intro { max-width: 46rem; font-size: 1.05rem; color: var(--text-dim); }

  .blocks { display: grid; gap: 28px 36px; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); margin-block: 48px; }
  .blocks h2 { font-size: 1.12rem; margin-bottom: 8px; }
  .blocks p { color: var(--text-dim); margin: 0; }

  .card ul { margin: 0; padding-left: 18px; color: var(--text-dim); font-size: 0.93rem; }
  .card li + li { margin-top: 4px; }

  .poster { margin: 28px 0 32px; }
  .poster img {
    display: block;
    width: 100%;
    max-width: 620px;
    border-radius: var(--radius-sm);
    background: #fff;
  }
  .poster figcaption { margin-top: 10px; color: var(--text-faint); font-size: 0.88rem; }

  .materials { list-style: none; margin: 0; padding: 0; display: grid; gap: 18px; }
  .materials li {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    align-items: baseline;
  }
  .materials a { color: var(--accent); }
  .materials .muted { font-size: 0.9rem; flex: 1 1 320px; }
</style>
