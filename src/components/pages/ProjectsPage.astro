---
import ProjectCard from '../ProjectCard.astro';
import { useTranslations, type Lang } from '../../i18n/ui';
import { TRACKS, trackColor, trackLabelKey } from '../../lib/tracks';
import { getProjects } from '../../lib/content';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);
const projects = await getProjects();
---

<h1>{t('nav.projects')}</h1>
<p class="muted">{t('projects.intro')}</p>

<div class="filters" role="group" aria-label={t('label.filter')}>
  <button class="chip" type="button" data-filter="all" aria-pressed="true">{t('label.all')}</button>
  {
    TRACKS.map((track) => (
      <button class="chip" type="button" data-filter={track} aria-pressed="false" style={`--track: ${trackColor[track]}`}>
        {t(trackLabelKey(track))}
      </button>
    ))
  }
</div>

<div class="grid" id="project-grid">
  {projects.map((project) => <ProjectCard project={project} lang={lang} />)}
</div>

<style>
  h1 { margin-top: 24px; }
  .filters { display: flex; flex-wrap: wrap; gap: 8px; margin: 24px 0 28px; }
  .chip {
    font-family: var(--mono);
    font-size: 0.78rem;
    padding: 6px 14px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--bg-elev);
    color: var(--text-dim);
    cursor: pointer;
  }
  .chip[aria-pressed='true'] {
    border-color: var(--track, var(--text-dim));
    color: var(--track, var(--text));
    background: color-mix(in srgb, var(--track, var(--text)) 10%, var(--bg-elev));
  }
</style>

<script>
  const grid = document.getElementById('project-grid');
  const chips = document.querySelectorAll<HTMLButtonElement>('.chip');

  function apply(filter: string) {
    chips.forEach((chip) => chip.setAttribute('aria-pressed', String(chip.dataset.filter === filter)));
    grid?.querySelectorAll<HTMLElement>('[data-tracks]').forEach((card) => {
      const tracks = (card.dataset.tracks ?? '').split(' ');
      card.hidden = filter !== 'all' && !tracks.includes(filter);
    });
    history.replaceState(null, '', filter === 'all' ? location.pathname : `#${filter}`);
  }

  chips.forEach((chip) => chip.addEventListener('click', () => apply(chip.dataset.filter ?? 'all')));

  // Track cards on the home page link straight to a filtered view.
  const initial = location.hash.replace('#', '');
  if (initial && [...chips].some((c) => c.dataset.filter === initial)) apply(initial);
</script>
