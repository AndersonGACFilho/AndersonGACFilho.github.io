---
import ProjectCard from '../ProjectCard.astro';
import PageHeader from '../PageHeader.astro';
import { useTranslations, type Lang } from '../../i18n/ui';
import { TRACKS, trackColor, trackLabelKey } from '../../lib/tracks';
import { getProjects } from '../../lib/content';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);
const projects = await getProjects();
---

<PageHeader kicker={t('kicker.projects')} title={t('nav.projects')} intro={t('projects.intro')} accent="var(--fullstack)" />

<div class="filters" role="group" aria-label={t('label.filter')}>
  <button class="chip" type="button" data-filter="all" aria-pressed="true">{t('label.all')}</button>
  {
    TRACKS.map((track) => (
      <button class="chip" type="button" data-filter={track} aria-pressed="false" style={`--track: ${trackColor[track]}`}>
        {t(trackLabelKey(track))}
      </button>
    ))
  }
</div>

<h2 class="so-leitor">{t('nav.projects')}</h2>
<div class="index" id="project-grid">
  {projects.map((project) => <ProjectCard project={project} lang={lang} />)}
</div>

<style>
  /* O FILTRO NÃO É MAIS PÍLULA TINGIDA. O marcado ganhava fundo na cor da
     trilha, que é a mesma forma do badge que estava em cada cartão — três
     pílulas coloridas no topo e mais três por linha abaixo. Agora o marcado
     se anuncia pelo traço embaixo, igual à página atual na navegação: é a
     mesma ideia ("você está aqui") e passa a ter a mesma forma.

     O traço não é o único sinal: a cor e o peso mudam junto, e o estado real
     está no `aria-pressed`, que é o que o leitor de tela anuncia. */
  .filters { display: flex; flex-wrap: wrap; gap: 6px; margin: -8px 0 24px; }
  .chip {
    font-family: var(--display);
    font-size: 0.82rem;
    font-weight: 500;
    padding: 6px 12px;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: none;
    color: var(--text-dim);
    cursor: pointer;
  }
  .chip:hover { border-color: var(--border-strong); color: var(--text); }
  .chip[aria-pressed='true'] {
    border-color: var(--border-strong);
    color: var(--track, var(--text));
    font-weight: 600;
    box-shadow: inset 0 -2px 0 0 var(--track, var(--text));
  }
</style>

<script>
  const grid = document.getElementById('project-grid');
  const chips = document.querySelectorAll<HTMLButtonElement>('.chip');

  function apply(filter: string) {
    chips.forEach((chip) => chip.setAttribute('aria-pressed', String(chip.dataset.filter === filter)));
    grid?.querySelectorAll<HTMLElement>('[data-tracks]').forEach((card) => {
      const tracks = (card.dataset.tracks ?? '').split(' ');
      card.hidden = filter !== 'all' && !tracks.includes(filter);
    });
    history.replaceState(null, '', filter === 'all' ? location.pathname : `#${filter}`);
  }

  chips.forEach((chip) => chip.addEventListener('click', () => apply(chip.dataset.filter ?? 'all')));

  // Track cards on the home page link straight to a filtered view.
  const initial = location.hash.replace('#', '');
  if (initial && [...chips].some((c) => c.dataset.filter === initial)) apply(initial);
</script>
