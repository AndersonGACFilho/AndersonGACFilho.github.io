---
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import TrackBadge from '../../../components/TrackBadge.astro';
import { formatDate, localize, useTranslations, type UIKey } from '../../../i18n/ui';
import { getArticles, articleSlug, articleAltPath } from '../../../lib/content';

const lang = 'pt' as const;
const t = useTranslations(lang);

export async function getStaticPaths() {
  const articles = await getArticles('pt');
  return Promise.all(
    articles.map(async (entry) => ({
      params: { slug: articleSlug(entry) },
      props: { entry, altPath: await articleAltPath(entry, 'pt') },
    })),
  );
}

const { entry, altPath } = Astro.props;
const { Content } = await render(entry);
---

<Base title={`${entry.data.title} — Anderson Gonçalves`} description={entry.data.summary} lang={lang} altPath={altPath}>
  <article class="prose">
    <p><a class="muted" href={localize('/articles', lang)}>← Artigos</a></p>
    <div class="badge-row">
      {entry.data.tracks.map((track) => <TrackBadge track={track} lang={lang} />)}
    </div>
    <h1>{entry.data.title}</h1>
    <p class="muted mono">{formatDate(entry.data.date, lang)}</p>
    {
      entry.data.venue && (
        <p class="venue">
          {t(`venue.${entry.data.venue.status}` as UIKey)} <strong>{entry.data.venue.name}</strong>
          {entry.data.venue.full && <span class="venue-full">{entry.data.venue.full}</span>}
          {entry.data.venue.url && <a href={entry.data.venue.url}>{t('cta.proceedings')} →</a>}
        </p>
      )
    }
    <Content />
  </article>
</Base>

<style>
  .venue { font-size: 0.92rem; color: var(--text-dim); }
  .venue-full { display: block; color: var(--text-faint); font-size: 0.85rem; }
</style>
